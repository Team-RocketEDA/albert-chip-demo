# BMC (not prove): the ROM lives in an `initial` block, which induction
# starts symbolically. x is a free input, so depth-3 BMC already covers
# every x (f_valid=1 from cycle 1 on).
[options]
mode bmc
depth 3

[engines]
smtbmc boolector

[script]
read -formal exp_lut.v exp_lut_formal.v
prep -top exp_lut_formal

[files]
src/components/exp_lut.v
src/tb/exp_lut/exp_lut_formal.v
