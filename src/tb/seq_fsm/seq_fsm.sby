# seq_fsm.sby — formal: one-hot phases, 30-state reachability,
# layer5b cal_addr format, no dead state (DONE reachable + sticky).
# Run:  cd src/tb/seq_fsm && sby -f seq_fsm.sby -d /tmp/sby_seq_fsm
[tasks]
bmc
cover

[options]
mode bmc
depth 200
cover: mode cover
cover: depth 60

[engines]
smtbmc

[script]
read -sv -DFORMAL seq_fsm.v
prep -top seq_fsm

[files]
../../components/seq_fsm.v
