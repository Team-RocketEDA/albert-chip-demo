# synth.ys — yosys synthesis of mac_array to sky130_fd_sc_hd (tt).
# Run via run.sh from this dir. Paths come from the environment.
read_verilog /home/alrida-ismail/github/rocketEDA/albert-chip-demo/src/components/mac_array.v
hierarchy -check -top mac_array
proc; opt; fsm; opt; memory; opt
booth
techmap; opt
dfflibmap -liberty /home/alrida-ismail/.local/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_100C_1v80.lib
opt
abc -liberty /home/alrida-ismail/.local/share/pdk/sky130A/libs.ref/sky130_fd_sc_hd/lib/sky130_fd_sc_hd__tt_100C_1v80.lib
opt; clean
stat
tee -o nl/report.txt stat
write_verilog -noattr -noexpr -nohex -nodec nl/mac_array.nl.v
