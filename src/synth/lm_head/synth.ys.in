# synth.ys — yosys synthesis of lm_head to sky130_fd_sc_hd (tt).
# Run via run.sh (yosys CWD = repo root so baked $readmemh paths resolve).
# Outputs land in out/<TAG>/ (@OUT@ = run.sh $OUT).
read_verilog @REPO@/src/components/fifo_sync.v
read_verilog @REPO@/src/components/lm_head.v
read_verilog @REPO@/src/components/mac_array.v
read_verilog @REPO@/src/components/seq_fsm.v
read_verilog @REPO@/src/components/sram_1r1w.v
hierarchy -check -top lm_head
proc; opt; fsm; opt; memory; opt
booth
techmap; opt
dfflibmap -liberty @LIB@
opt
abc -liberty @LIB@
opt; clean
stat
tee -o @OUT@/nl/report.txt stat
write_verilog -noattr -noexpr -nohex -nodec @OUT@/nl/lm_head.nl.v
